# Athlete data is private health data — never commit it.
# (The committed, consented sample lives under examples/data/ instead.)
# Everything under data/ is ignored by default, so a new folder (labs, a new
# connector's cache, your own season specs) is private without anyone
# remembering to list it here. Only fixtures and .gitkeep files are tracked.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/fixtures/**
# Real recordings stay out even though they sit under fixtures/.
/data/fixtures/private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Env & secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp

# Vendored Open Wearables (added as submodule later)
/third_party/open-wearables/
